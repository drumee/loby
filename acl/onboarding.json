      }
    },
    "save_team_size": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "save_intent": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "save_challenges": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "save_tools": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
    "save_privacy": {
      "scope": "hub",
      "permission": {
        "src": "owner"
      }
    },
